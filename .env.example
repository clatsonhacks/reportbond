# Copy to .env (never commit .env). Use fresh wallets per network (docs/NETWORKS.md).
NETWORK=testnet                 # testnet | mainnet | local
DEPLOYER_PRIVATE_KEY=0x...      # only for forge script deploys
RELAYER_PRIVATE_KEY=0x...       # pays gas to deliver signed verdicts and refunds; keep ~1-2 USDC
RELAYER_ADDRESS=0x...
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=   # optional, from cloud.reown.com, enables mobile wallets
# KEEPER_INTERVAL_MS=3600000

# Testnet scenario wallets for `pnpm e2e` (TESTNET ONLY): maintainer ~12 USDC, reporter ~15, stranger ~0.5
TEST_MAINTAINER_PRIVATE_KEY=0x...
TEST_REPORTER_PRIVATE_KEY=0x...
TEST_STRANGER_PRIVATE_KEY=0x...

# GitHub App. Easiest: open /setup/github and click the button (see GITHUB_APP.md).
# Leave empty to run without GitHub.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY=          # one line, newlines written as \n
# BOND_WINDOW_HOURS=48           # time a reporter has to pay the deposit after filing on GitHub
# SETUP_SECRET=                  # deployed sites only: allows /setup/github; remove after setup

# AI reviewers (setup, triage, critic). Set one key; Groq is used if both are set.
GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# AI_MODEL=                      # default: openai/gpt-oss-120b on Groq, claude-opus-5-5 on Anthropic
