# Copy to .env (never commit .env). Use fresh wallets per network (docs/NETWORKS.md).
NETWORK=testnet                 # testnet | mainnet | local
DEPLOYER_PRIVATE_KEY=0x...      # only for forge script deploys
RELAYER_PRIVATE_KEY=0x...       # pays gas to deliver signed verdicts and refunds; keep ~1-2 USDC
RELAYER_ADDRESS=0x...
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=   # optional, from cloud.reown.com, enables mobile wallets
# KEEPER_INTERVAL_MS=3600000
