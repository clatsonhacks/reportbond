{
  "buildCommand": "pnpm build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "env": {
    "NETWORK": "testnet"
  },
  "crons": [
    {
      "path": "/api/cron/keeper",
      "schedule": "0 * * * *"
    }
  ]
}
